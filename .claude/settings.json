{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(cargo publish:*)",
      "WebFetch(domain:polyformproject.org)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh repo view:*)",
      "Bash(centy --help:*)",
      "Bash(centy create --help:*)",
      "Bash(centy create issue --help:*)",
      "Bash(centy create issue:*)",
      "Bash(centy issue:*)",
      "Bash(git push:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(git checkout:*)",
      "Bash(npm init:*)",
      "Bash(pnpm init:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm exec husky:*)",
      "Bash(centy update:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(gh pr create:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(gh pr merge:*)",
      "Bash(git fetch:*)",
      "Bash(centy update issue:*)",
      "Bash(gh pr create:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(git fetch:*)",
      "Bash(cargo package:*)",
      "Bash(grep:*)",
      "Bash(cargo doc:*)",
      "Bash(wc:*)",
      "Bash(cargo metadata:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git tag:*)",
      "Bash(cargo tree:*)",
      "Bash(gh run rerun:*)",
      "Bash(git status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo list:*)"
    ],
    "deny": ["Bash(gh issue create:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx block-no-verify"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op read"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm dlx ai-fs-permissions --op write"
          }
        ]
      }
    ]
  }
}
